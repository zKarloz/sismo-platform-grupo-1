# ============================================================
# FASE 1 | VARIABLES DEL BACKEND (SIN CREDENCIALES REALES)
# Copiar a: services/api/.env
# ============================================================
APP_NAME="Sistema de Monitoreo Sísmico | API"
APP_ENV=development
API_V1_PREFIX=/api/v1

# ============================================================
# ORIGENES WEB AUTORIZADOS POR CORS
# En Render, reemplazar por la URL HTTPS definitiva de Vercel.
# Para varios orígenes, separarlos con comas y sin comillas.
# ============================================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# CONEXION POSTGRESQL (FUTURA INTEGRACION CON SUPABASE)
# Responsabilidad: Integrante 4. No publicar secretos.
# La API /health NO requiere conexión a la base de datos.
# ============================================================
DATABASE_URL=
